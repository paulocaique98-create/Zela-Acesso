{
  "name": "zela-acesso",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Zela Acesso - controle de acesso fisico multi-tenant (Arx Tecnologia)",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "db:start": "node scripts/supabase-local.mjs start",
    "db:status": "node scripts/supabase-local.mjs status",
    "db:reset": "node scripts/supabase-local.mjs reset",
    "db:test": "node scripts/supabase-local.mjs test",
    "db:seed": "node scripts/seed-dev.mjs",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "e2e": "playwright test",
    "e2e:pass": "node apps/edge-agent/e2e/zela-pass.e2e.mjs",
    "e2e:reader": "node apps/reader/e2e/reader.browser.mjs",
    "rbac:drift": "node scripts/check-rbac-drift.mjs",
    "db:stop": "node scripts/supabase-local.mjs stop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "eslint": "^10.12.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.9"
  }
}
